# ---- Local development ----
# Fill in your own values and copy this file to .env (never commit .env).

# PostgreSQL connection (no Docker; native install). Keep the postgresql+psycopg:// prefix.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/campus_marketplace

# Flask: use long random values, a different one for each. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-different-random-secret
FLASK_ENV=development

# ---- Email to students (optional) ----
# Students get an email when a moderator approves or rejects their listing. Leave these
# empty to skip emails.
#
# Option A, recommended: Brevo's web API (free: 300 emails a day). It uses ordinary HTTPS,
# so it works where SMTP ports are blocked. In Brevo: add and verify a sender address
# (Senders), then create an API key (SMTP & API > API Keys).
# BREVO_API_KEY=xkeysib-your-api-key
# MAIL_FROM=UniMart <support.unimart.ng@gmail.com>   Must be a sender you verified in Brevo.
#
# Option B: any SMTP account. For Gmail: turn on 2-step verification, create an
# "app password" (Google Account > Security > App passwords) and use it as MAIL_PASSWORD.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-letter-app-password
# MAIL_FROM=UniMart <you@gmail.com>
#
# FRONTEND_URL=http://localhost:5173   The website address, for the links in emails.

# ---- How long a student stays logged in (days; the default is 30) ----
# Suspending a student, changing a password and "log out other devices" end logins at once.
# STUDENT_LOGIN_DAYS=30

# ---- Production (set these in the hosting service's settings, not in a file) ----
# FLASK_ENV=production      The app then refuses to start unless the secrets above are real.
# DATABASE_URL=...          The production database address from the host.
# UPLOAD_FOLDER=...         Where photos are stored (a permanent disk on the host).
# CORS_ORIGINS=             Leave empty: the site and the API share one address.
# PORT=...                  Usually set by the host.
