# PostgreSQL connection (no Docker; native install)
# Fill in your own values and copy to .env. Keep the postgresql+psycopg:// prefix.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/campus_marketplace

# Flask: use long random values, a different one for each. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-different-random-secret
FLASK_ENV=development
