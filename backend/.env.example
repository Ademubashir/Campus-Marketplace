# ---- Local development ----
# Fill in your own values and copy this file to .env (never commit .env).

# PostgreSQL connection (no Docker; native install). Keep the postgresql+psycopg:// prefix.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/campus_marketplace

# Flask: use long random values, a different one for each. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-different-random-secret
FLASK_ENV=development

# ---- Production (set these in the hosting service's settings, not in a file) ----
# FLASK_ENV=production      The app then refuses to start unless the secrets above are real.
# DATABASE_URL=...          The production database address from the host.
# UPLOAD_FOLDER=...         Where photos are stored (a permanent disk on the host).
# CORS_ORIGINS=             Leave empty: the site and the API share one address.
# PORT=...                  Usually set by the host.
